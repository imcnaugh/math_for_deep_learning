   "source": "## Histograms",
   "id": "1e3d31c7ae5a4f80"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "sample_count = 10000\n",
    "n = np.random.randint(0, 10, sample_count)\n",
    "h = np.bincount(n)\n",
    "print(\"h: \", h)\n",
    "dist = h / sample_count\n",
    "print(\"dist: \", dist)"
   ],
